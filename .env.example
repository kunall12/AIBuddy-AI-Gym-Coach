# Anthropic Claude API Key for Post-workout Coach Summaries & Interactive Chat (Feature 2)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model name for Claude coaching (defaults to claude-3-7-sonnet-latest if omitted)
